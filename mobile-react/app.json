{
  "expo": {
    "name": "Sipetang",
    "slug": "mobile-react",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sipetangLogo.jpg",
    "scheme": "mobilereact",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/sipetangLogo.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.maiiww.mobilereact"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/sipetangLogo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sipetangLogo.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "66b0a400-8efa-4305-afcd-5640b87da9e7"
      }
    }
  }
}
